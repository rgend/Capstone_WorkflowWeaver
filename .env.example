# .env.example — copy to backend/.env and fill in your credentials.
# Every value below is optional: WorkflowWeaver runs fully in MOCK_MODE with
# zero keys set (see "Known Limitations" in README.md). Real integrations
# switch on automatically the moment their variables are supplied.

# --- LLM (required for real, LLM-driven planning; falls back to a
#     deterministic keyword planner when unset) ---
# LLM_PROVIDER: "anthropic" (Claude tool-use) or "google-gemini-ai" (Gemini
# function-calling). LLM_MODEL overrides the per-provider default when set.
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=4096
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4o

# --- Notion MCP ---
NOTION_TOKEN=your_notion_integration_token
NOTION_PAGE_ID=your_target_notion_page_id
# Windows only, and only if you have more than one Node.js install on PATH:
# override the launch command if the default "npx" resolves to an
# incompatible/older Node (symptom: "You must supply a command" or an ESM
# SyntaxError from notion-mcp-server's cli.mjs on startup).
# NOTION_MCP_COMMAND=C:\path\to\a\working\node\npx.cmd

# --- Google Drive MCP ---
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_target_drive_folder_id

# --- Slack (Web API, chat.postMessage — bot needs the chat:write scope and
#     must be a member of the target channel) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=your_target_channel_id

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App behavior ---
# true (default): every tool call (Notion/Drive/Slack) is simulated with
# realistic mock output, regardless of the keys above. Set to false once you
# want live writes to go out to your real Notion/Drive/Slack accounts.
MOCK_MODE=true
MAX_STEP_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1.5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
