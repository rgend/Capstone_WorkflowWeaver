# .env.example — copy to backend/.env and fill in your credentials.
# Every value below is optional: WorkflowWeaver runs fully in MOCK_MODE with
# zero keys set (see "Known Limitations" in README.md). Real integrations
# switch on automatically the moment their variables are supplied.

# --- LLM (required for real, LLM-driven planning; falls back to a
#     deterministic keyword planner when unset) ---
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_MODEL=gpt-4o

# --- Notion MCP ---
NOTION_TOKEN=your_notion_integration_token
NOTION_PAGE_ID=your_target_notion_page_id

# --- Google Drive MCP ---
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_DRIVE_FOLDER_ID=test

# --- Microsoft Teams ---
TEAMS_WEBHOOK_URL=your_teams_webhook_url

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App behavior ---
# true (default): every tool call (Notion/Drive/Teams) is simulated with
# realistic mock output, regardless of the keys above. Set to false once you
# want live writes to go out to your real Notion/Drive/Teams accounts.
MOCK_MODE=true
MAX_STEP_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=1.5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
