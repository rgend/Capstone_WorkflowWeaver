    N3 -->|"create_project_page"| Notion
    N3 -->|"create_document"| Drive
    N3 -->|"post_message"| Teams
    N4 -->|"archive_page / delete_file"| Notion
    N4 -->|"archive_page / delete_file"| Drive

    N2 -.->|"generation span"| Trace
    N3 -.->|"tool span per attempt"| Trace
